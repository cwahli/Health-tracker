{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --exclude tests/golden_inbox.test.ts",
    "test:receptionist": "vitest run src/server/receptionist/handoffContract.test.ts src/components/chat-cards/ReceptionistCard.i18n.test.tsx",
    "test:bio": "vitest run src/utils/biomarkerIdentity.test.ts src/utils/biomarkerSanitize.test.ts src/utils/dataSanitize.test.ts src/utils/biomarkerLifecycle.test.ts tests/golden_biomarker.test.ts",
    "test:food": "vitest run server_derivation.test.ts server_dish_classify.test.ts server_vision_scout.test.ts server_brand_match.test.ts server_portion_clarify.test.ts",
    "test:sync": "vitest run src/utils/syncUtils.regression.test.ts src/utils/foodLogDedupe.test.ts src/utils/firestoreUtils.test.ts",
    "test:golden": "vitest run tests/golden_meals.test.ts tests/golden_biomarker.test.ts",
    "test:e2e": "playwright test",
    "test:benchmark:receptionist": "tsx prototype/receptionist/runner.ts --case UC-01",
    "test:benchmark:biomarkers": "tsx prototype/biomarkers/runner.ts --case C1",
    "test:benchmark:food": "tsx prototype/meallog/runner.ts --case 08",
    "test:benchmark:meal-golden": "node scripts/meal-golden-bench.mjs",
    "test:prepush": "npm run test:receptionist && npm run test:bio && npm run test:food && npm run lint",
    "check:tests": "vitest run src/mealBuild/__tests__",
    "test:from-debug": "tsx scripts/test-from-debug.ts",
    "scorecard:debug": "node scripts/assert-master-scorecard.mjs",
    "golden:from-debug": "node scripts/golden-from-debug.mjs",
    "golden:inbox": "vitest run tests/golden_inbox.test.ts",
    "golden:inbox:watch": "vitest tests/golden_inbox.test.ts",
    "golden:promote": "node scripts/golden-promote.mjs",
    "golden:loop": "node scripts/golden-loop.mjs",
    "prebuild:web": "node scripts/write-git-version.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.5",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.4",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "recharts": "^3.9.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "description": "",
  "main": "server.ts",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
