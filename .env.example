# Gemini lane (shared infra): bot-host reads GEMINI_API_KEY from host env —
# VPS ~/.config/bot-host/common.env, phone ~/.config/opencode-bot/<id>.env.
GEMINI_API_KEY=
# OpenCode Go lane (website server → opencode gateway, direct HTTPS):
# same subscription key the CLI uses (`opencode auth export`). Go requires
# User-Agent + x-opencode-session headers (server sends both); without them
# the gateway 403s. Website traffic shares the personal Go quota.
OPENCODE_API_KEY=
USDA_API_KEY=
BRAVE_API_KEY=
ADMIN_MIGRATION_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_ACCOUNT_ID=

# --- WhatsApp inverted-code login (pure inbound, $0: we never send) ---
# Business/display number for the wa.me link (digits only on the server).
WHATSAPP_BUSINESS_NUMBER=
# Meta webhook handshake token (must match Callback Verify Token).
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret: signs every webhook POST (X-Hub-Signature-256). Never the verify token.
WHATSAPP_APP_SECRET=

# --- Telegram bot tokens (one per bot, one poller per token) ---
# Unified master file for BOTH runtimes:  ~/.config/bot-host/tokens.env
#   1. Edit it (one KEY=value per bot)
#   2. node scripts/sync-bot-tokens.mjs --restart
#        bot-host bots -> ~/.config/bot-host/<id>.env   (systemd loads <id>.env)
#        hermes bots   -> ~/.hermes[ /profiles/<p>]/.env (only the token line;
#                         restart the Hermes gateway manually to apply)
#   3. See everything:  node scripts/sync-bot-tokens.mjs --list
# systemd loads common.env (shared, non-secret) + <id>.env only, so a running
# bot-host bot never sees the other bots' tokens.
# --- bot-host runtime ---
OPENCODE_BOT_TOKEN=
MOBILE_BOT_TOKEN=
VM_BOT_TOKEN=
VM2_BOT_TOKEN=
COLLAB_BOT_TOKEN=
# --- hermes runtime ---
HERMES_DEFAULT_TOKEN=
HERMES_QA_MEAL_TOKEN=
HERMES_ORCHESTRATOR_TOKEN=
HERMES_MEAL_AUDIT_TOKEN=
HERMES_QA_BIOMARKER_TOKEN=
HERMES_QA_ONBOARDING_TOKEN=
