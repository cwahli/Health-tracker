#!/bin/bash
# ht-run <tool:freebuff|opencode|cline> <session> <prompt-file> [model|@pool]
# Part 2 of tmp/ht-allowance-watch/TICKET.md: ONE launcher for ALL free tools.
# Part of tmp/ht-freebuff-autocontinue/TICKET.md: the .meta sidecar also carries
# continue_count (0 on launch) so ht-watch can enforce the 12-continue cap, and
# the freebuff resume prompt is assembled from the prompt file's directory.
#
# Model-parity 2026-10-10: the pick is NOT decided here any more. Omitting
# [model] (or passing a pool name — @free / @light_free / @go) delegates to
# `ht-model pick <pool> --tool <tool>`, which runs the repo's shared
# model-switch walk: the same pool filter, rating order and depletion verdict
# the Telegram bot's /model_* commands use. An explicit model still wins
# (override: the PM passes China-origin models for MiChat work).
#
# Repo copies of this logic: tools/telegram-provider-router/bin/ht-run and
# scripts/ht-model.mjs + scripts/lib/model-switch.mjs (the implementation).
#
# - Always runs inside tmux session <session> and opens a visible desktop
#   terminal attached (reuses ht-show). Logs the pane to <logs>/<session>.log.
# - freebuff: current ht-freebuff logic (default model, wait "Enter a coding
#   task", type prompt with tmux send-keys -l, Enter). It takes no model; a
#   pool arg is refused rather than silently ignored.
# - opencode: opencode run -m <model> "<prompt>"   (non-interactive)
# - cline:    cline -m <model> -c <workspace> "<prompt>" (non-interactive, auto-approve)
# - If [model] omitted -> `ht-model pick free --tool <tool>` (coding pool).
# - @free/@coding -> coding pool, @light_free/@light -> light, @go -> Go plan.
#   Empty pool -> exit 3 with the pool's soonest reset named.
# - Writes <logs>/<session>.meta (tool/model/prompt/continue_count)
#   which ht-watch reads for per-tool detection + freebuff auto-continue.
#
# Env: HT_WORKSPACE (repo checkout), HT_ROUTER_DIR (router dir),
#      HT_AC_LOGS_DIR / HT_LOG_DIR (log dir), HT_BIN_DIR (sibling scripts),
#      HT_MODEL_BIN (ht-model path), HT_DRY_RUN=1 (resolve the model, print it,
#      do not launch — the test seam).
set -u
WORKSPACE="${HT_WORKSPACE:-/workspace/biomarker-and-nutrient-tracker}"
BIN_DIR="${HT_BIN_DIR:-/home/box/bin}"
MODEL_BIN="${HT_MODEL_BIN:-$BIN_DIR/ht-model}"
tool="${1:-}"; session="${2:-}"; prompt_file="${3:-}"; model="${4:-}"

usage() { echo "usage: ht-run <tool:freebuff|opencode|cline> <session> <prompt-file> [model|@free|@light_free|@go]" >&2; exit 1; }
[ -n "$tool" ] && [ -n "$session" ] && [ -n "$prompt_file" ] && [ -f "$prompt_file" ] || usage
case "$tool" in freebuff|opencode|cline) ;; *) usage ;; esac

LOGS_DIR="${HT_AC_LOGS_DIR:-${HT_LOG_DIR:-/workspace/logs}}"
LOG="$LOGS_DIR/$session.log"
META="$LOGS_DIR/$session.meta"
mkdir -p "$LOGS_DIR"

# POSIX single-quote escaping for sh -c payload
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# ---- model resolution: the shared picker decides, this script only obeys ----
if [ "$tool" = freebuff ]; then
  case "$model" in
    @*) echo "FAIL: freebuff takes no model/pool (it runs its own default lane)" >&2; exit 1 ;;
  esac
  model=""
else
  if [ -z "$model" ]; then
    pick_pool="free"
  else
    pick_pool="${model#@}"
    if [ "$pick_pool" = "$model" ]; then
      pick_pool=""   # explicit model override — leave it alone
    fi
  fi
  if [ -n "${pick_pool:-}" ]; then
    [ -x "$MODEL_BIN" ] || { echo "FAIL: $MODEL_BIN not executable (set HT_MODEL_BIN)" >&2; exit 3; }
    model="$("$MODEL_BIN" pick "$pick_pool" --tool "$tool" 2>&1)"
    if [ $? -ne 0 ] || [ -z "$model" ]; then
      [ -z "$model" ] && echo "FAIL: pool @${pick_pool} has no available $tool lane" >&2
      [ -n "$model" ] && echo "$model" >&2
      exit 3
    fi
  fi
fi

# ---- single-session guard (2026-10-10 switch fix): Freebuff allows ONE CLI
# session per login. Refuse to start a second one while another live tmux
# session's .meta says tool=freebuff.
if [ "$tool" = freebuff ]; then
  for m in "$LOGS_DIR"/*.meta; do
    [ -f "$m" ] || continue
    os=$(basename "$m" .meta); [ "$os" = "$session" ] && continue
    grep -q '"tool": *"freebuff"' "$m" 2>/dev/null || continue
    if tmux has-session -t "$os" 2>/dev/null; then
      echo "FAIL: freebuff is single-session and already in use by tmux session $os" >&2; exit 4
    fi
  done
fi

if [ "${HT_DRY_RUN:-0}" = 1 ]; then
  echo "DRY: tool=$tool model=${model:-default}"
  exit 0
fi

# ---- sidecar meta for ht-watch (tool/model/prompt provenance + continue cap) ----
# continue_count is a LAUNCH: a fresh job starts at 0 (ht-watch keeps counting
# freebuff auto-continues in <session>.cont; 12 => CONTINUE_CAP).
TOOL="$tool" MODEL="$model" PF="$prompt_file" WS="$WORKSPACE" node -e '
console.log(JSON.stringify({tool:process.env.TOOL,model:process.env.MODEL,prompt_file:process.env.PF,workspace:process.env.WS,continue_count:0,startedAt:new Date().toISOString()},null,1));' > "$META"
rm -f "$LOGS_DIR/$session.gatefails"   # a fresh launch gets fresh finish-gate attempts

prompt=$(tr '\n' ' ' < "$prompt_file")

tmux kill-session -t "$session" 2>/dev/null && sleep 1
echo "==== ht-run $tool session=$session model=${model:-default} $(date -u +%FT%TZ) ====" >> "$LOG"

if [ "$tool" = "freebuff" ]; then
  # Current ht-freebuff behaviour, kept verbatim (+ pane logging + meta).
  tmux new-session -d -s "$session" -x 200 -y 50 "cd $WORKSPACE && freebuff --trust-agents; exec bash"
  sleep 0.3
  tmux pipe-pane -t "$session" -o "cat >> $LOG"
  "$BIN_DIR/ht-show" "$session"
  for i in $(seq 1 30); do tmux capture-pane -p -t "$session" 2>/dev/null | grep -q 'Freebucks' && break; sleep 1; done
  sleep 1; tmux send-keys -t "$session" Enter            # accept default model
  for i in $(seq 1 30); do tmux capture-pane -p -t "$session" 2>/dev/null | grep -q 'Enter a coding task' && break; sleep 1; done
  sleep 2; tmux send-keys -t "$session" -l "$prompt"; sleep 2; tmux send-keys -t "$session" Enter
  sleep 8
  if ! tmux capture-pane -p -t "$session" 2>/dev/null | grep -q 'working'; then
    # 2026-10-10: a blank chat must not count as a launch (ht-watch then wakes the PM).
    echo "FAIL: freebuff prompt was not accepted (no 'working' after submit) session=$session" >&2
    exit 4
  fi
  echo "OK: Freebuff working (model=default)"
  echo "OK: freebuff session=$session model=default log=$LOG"
  exit 0
fi

case "$tool" in
  opencode) cmd="opencode run -m $(sq "$model") $(sq "$prompt")"
            # optional: jobs that must touch dirs outside their cwd (opencode run auto-rejects
            # external_directory). e.g. HT_OC_PERMISSION='{"external_directory":"allow"}'
            [ -n "${HT_OC_PERMISSION:-}" ] && cmd="OPENCODE_PERMISSION=$(sq "$HT_OC_PERMISSION") $cmd" ;;
  cline)    cmd="cline -m $(sq "$model") -c $(sq "$WORKSPACE") $(sq "$prompt ")" ;;  # trailing space: CLI rejects single-token prompts
esac

inner="cd $WORKSPACE && $cmd; rc=\$?; echo; echo \"=== $session finished (exit \$rc) ===\"; exec bash"
tmux new-session -d -s "$session" -x 200 -y 50 "bash -lc $(sq "$inner")"
sleep 0.3
tmux pipe-pane -t "$session" -o "cat >> $LOG"
"$BIN_DIR/ht-show" "$session"
# 2026-10-10: verify the run actually started (not exited straight away).
sleep "${HT_RUN_VERIFY_SECS:-8}"
if ! tmux has-session -t "$session" 2>/dev/null || tmux capture-pane -p -t "$session" 2>/dev/null | grep -q "=== $session finished (exit"; then
  echo "FAIL: $tool run exited right after launch session=$session (see $LOG)" >&2
  exit 4
fi
echo "OK: $tool session=$session model=$model cwd=$WORKSPACE log=$LOG"
