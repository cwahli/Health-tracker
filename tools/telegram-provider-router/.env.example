# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# OpenCode HTTP serve (default http://127.0.0.1:4096)
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_DEFAULT_MODEL=opencode/muse-spark-1.3-contributor-free
OPENCODE_IDLE_MS=60000
OPENCODE_MAX_MS=7200000
OPENCODE_PROGRESS_MS=60000

# Cline
CLINE_DEFAULT_MODEL=cline-free/deepseek-v4.1-flash
CLINE_TIMEOUT_MS=1200000

# Token Harbor (OpenAI-compatible)
TOKEN_HARBOR_API_KEY=
TOKEN_HARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKEN_HARBOR_DEFAULT_MODEL=deepseek-v4.1-flash:free

# Cloudflare Workers AI (Qwen free neurons)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_API_TOKEN=

# Workspace the coding tools edit
WORKSPACE=/path/to/Health-tracker

# Default Telegram route: opencode | cline | tokenharbor | freebuff | cloudflare
DEFAULT_PROVIDER=opencode
