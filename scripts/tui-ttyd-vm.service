[Unit]
Description=Typeable TUI terminal for this host's bot chats (ttyd, behind the gateway)
Documentation=file:///home/ubuntu/bot-host-r14/scripts/tui-gateway.mjs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bot-host-r14
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.opencode/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
# The attach script resolves THIS chat's session at attach time, so the
# terminal is the same conversation the bot is in, not a second agent.
Environment=TUI_BOT_ID=vm
Environment=TUI_STATE_ROOT=/home/ubuntu/.local/state/bot-host
Environment=TUI_WORKTREE=/home/ubuntu/bot-host-r14
Environment=OPENCODE_BIN=/home/ubuntu/.opencode/bin/opencode
# Which tool the terminal launches is decided per chat at attach time (see
# scripts/lib/tui-surface.mjs), and a chat on Cline needs the cline CLI. This
# unit's PATH has no ~/.npm-global/bin, where cline lives, so a bare `cline`
# would not resolve and the attach would die on a chat that is on Cline. Both
# binaries are named because both are live lanes on this bot.
Environment=CLINE_BIN=/home/ubuntu/.npm-global/bin/cline
# The tmux session is named for the LOCATION, because a tmux session list is
# read to answer "which box is this on?". "opencode-tui" said neither location
# nor bot on a box that runs two of them. vm2's twin is VM-tui-vm2: one
# session per bot, so the two chats never share a terminal.
Environment=TUI_TMUX_NAME=VM-tui
# ttyd's own credential. It lives here, 0600, and is expanded into ExecStart by
# systemd — it is NOT in this file. An earlier version had the credential only in
# the INSTALLED unit, so reinstalling from scripts/ silently dropped it and ttyd
# would have answered the whole internet.
EnvironmentFile=-/home/ubuntu/.config/bot-host/tui-ttyd.env
# Loopback only. The gateway admits a request; nothing else can reach this
# socket, and it must never be reachable from the internet directly.
ExecStart=/usr/bin/ttyd --port 8896 --interface 127.0.0.1 --base-path /tty \
  --writable --max-clients 1 --once=false \
  -c ${TUI_TTYD_USER}:${TUI_TTYD_PASSWORD} \
  --check-origin --terminal-type xterm-256color \
  --client-option fontSize=13 \
  --ping-interval 20 \
  /home/ubuntu/bot-host-r14/scripts/mobile/tui-attach.sh
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
