      "request": {
        "method": "GET",
        "url": "https://api.search.brave.com/res/v1/web/search?q=vitamin%20D%20and%20muscle%20strength&count=10",
        "headers": { "X-Subscription-Token": "fixture-brave-key", "Accept": "application/json" },
        "body": ""
      },
      "expectedHits": [
        {
          "url": "https://example.test/brave-d-1",
          "title": "Vitamin D supplementation and muscle strength in adults",
          "snippet": "A randomised trial of vitamin D and grip strength."
        },
        {
          "url": "https://example.test/brave-d-2",
          "title": "Vitamin D and falls: a second look",
          "snippet": "Another summary."
        }
      ],
      "ok": {
        "status": 200,
        "body": {
          "type": "search",
          "web": {
            "type": "search",
            "results": [
              {
                "title": "Vitamin D supplementation and muscle strength in adults",
