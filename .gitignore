# Local scratch (live captures, renders, replay scripts) — never commit
tmp/
qa-evidence/
# meal-qa-proof.mjs renders per-stage DIAGRAMS here. Not L18 evidence — the
# screenshots of the app come from meal-qa-l18.mjs and go to Drive. Generated
# locally, so nothing to commit, but named apart from qa-evidence/ so a diagram
# is never filed as proof of what the app showed.
stage-diagrams/

# Aider local
.aider*
scripts/_qwen_ping.txt
.freebuff/

# Antigravity & mobile symlinks
.antigravity/
settings.json
/agent
download
screenshots

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# b2b dead letters used to be written here (default process.cwd()), so a
# serving clone accumulated untracked files. They live under the state
# root now (bot-host.mjs: deadLetterRoot); this keeps any that a box still
# holds from reading as working-tree changes.
specs/bot-handoff-dead-letter/

# bugctl offline write queue (local replay state, never committed)
.bugctl-queue.jsonl
