{
  "version": 1,
  "rule": "Copy a mechanism from another journey. Never replace this journey's instruction or schema with the other journey's. Features listed here must stay on the live call, not only in debug or chat.",
  "journeys": [
    {
      "id": "food_log",
      "label": "Meal log",
      "instruction_file": "server_vision_scout.ts",
      "schema_file": "src/server/food/server_food_analyze_schema.ts",
      "schema_export": "visionScoutResponseSchema",
      "must_in_instruction": [],
      "must_not_in_instruction": [
        "allExtractedDishes"
      ],
      "must_in_schema_file": [
        "visionScoutResponseSchema"
      ],
      "call_sites": [
        "src/server/food/server_food_scout_source.ts"
      ],
      "call_sites_must_contain": [
        "scoutSystemInstruction",
        "visionScoutResponseSchema"
      ]
    },
    {
      "id": "food_compare",
      "label": "Compare meals",
      "instruction_file": "prototype/meallog/compare/scout_only_compare_instructions.ts",
      "schema_file": "src/server/food/server_food_analyze_schema.ts",
      "schema_export": "scoutOnlyCompareResponseSchema",
      "must_in_instruction": [
        "EVALUATION ONLY",
        "allExtractedDishes"
      ],
      "must_not_in_instruction": [],
      "must_in_schema_file": [
        "allExtractedDishes",
        "scoutOnlyCompareResponseSchema"
      ],
      "call_sites": [
        "server_food_analyze_run.ts",
        "server_food_analyze_run_scout.ts",
        "src/server/food/server_food_scout_source.ts"
      ],
      "call_sites_must_contain": [
        "scoutOnlyCompareSystemInstruction"
      ]
    }
  ],
  "features": [
    {
      "id": "nutrition_targets",
      "label": "Nutrition targets on meal log and compare live LLM calls",
      "asked": "repeated",
      "files_must_contain": {
        "server_food_analyze_run.ts": [
          "buildNutritionTargetStatus",
          "systemInstruction: resolvedScoutSystemInstruction"
        ],
        "server_food_analyze_run_scout.ts": [
          "buildNutritionTargetStatus",
          "systemInstruction: resolvedScoutSystemInstruction",
          "scoutOnlyCompareSystemInstruction"
        ]
      }
    },
    {
      "id": "kcal_one_writer",
      "label": "finalizeDishLedger is the only kcal writer on log",
      "files_must_contain": {
        "docs/agent/domains/food-calc.md": [
          "`finalizeDishLedger` is the only writer"
        ]
      }
    },
    {
      "id": "egress_conservation",
      "label": "No unbounded Supabase/D1 pull; no SELECT *; job poll only when hasActiveJob; no direct client Supabase",
      "asked": "repeated",
      "files_must_contain": {
        "src/jobs/SupabaseJobSync.ts": [
          "hasActiveJob",
          "isDirectClientSupabaseDisabled = true"
        ],
        "src/App.tsx": [
          "lastSyncTime"
        ],
        "scripts/assert-egress-bomb.mjs": [
          "EGRESS_BOMB"
        ]
      }
    },
    {
      "id": "meal_image_unique",
      "label": "Meal image lists: one URL per capture; drop data:/blob: when /photos/ or https exists",
      "asked": "repeated",
      "files_must_contain": {
        "src/utils/foodImageSources.ts": [
          "uniqueMealImageUrls",
          "startsWith('data:')"
        ],
        "src/utils/foodImageSources.test.ts": [
          "drops data: copies once the same captures exist on /photos/",
          "keeps local data: URLs when nothing has been uploaded yet"
        ]
      }
    },
    {
      "id": "biomarker_lifestyle_exclusion",
      "label": "Behavioral/lifestyle metrics excluded from laboratory plausibility ratio checks",
      "asked": "repeated",
      "files_must_contain": {
        "src/utils/biomarkers.ts": [
          "isExcludedDeviceMetric"
        ],
        "src/utils/biomarkerSanitize.test.ts": [
          "does not flag everyday step counts as improbable"
        ]
      }
    },
    {
      "id": "job_milestone_telemetry",
      "label": "Background job streaming dispatches progress milestones for medical and food pipelines",
      "asked": "repeated",
      "files_must_contain": {
        "serverJobs.ts": [
          "msg.toLowerCase().includes('extract')",
          "msg.toLowerCase().includes('classified')",
          "msg.toLowerCase().includes('running agent')"
        ]
      }
    },
    {
      "id": "builder_ne_tier3_ab_scorer",
      "label": "Agent that authors a method must not run/score its own live A/B or Tier-3 quality claim",
      "asked": "repeated",
      "files_must_contain": {
        "docs/agent/JOURNEY.md": [
          "Builder \u2260 Tier-3 scorer",
          "frozen ground-truth scorecard"
        ],
        "plan/RELIABILITY.md": [
          "Builder must not author and score the same live A/B"
        ]
      }
    },
    {
      "id": "kcal_density_cap",
      "label": "kcal/g > 9.2 is unsavable at any consumed weight",
      "asked": "repeated",
      "files_must_contain": {
        "src/server/food/server_food_dietitian_dispatch.ts": [
          "g > 0 && density > 9.2"
        ],
        "src/server/food/server_food_dietitian_dispatch.test.ts": [
          "6300 kcal / 70g"
        ],
        "docs/agent/domains/food-calc.md": [
          "kcal/g > 9.2"
        ]
      }
    }
  ],
  "sibling_pairs": [
    {
      "a": "food_log",
      "b": "food_compare",
      "note": "Learn-from either way: freeze the destination instruction_file and schema_export."
    }
  ]
}
