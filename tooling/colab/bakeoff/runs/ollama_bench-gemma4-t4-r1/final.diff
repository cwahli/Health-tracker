 // fg may carry alpha: blend over opaque bg first (how the browser paints it).
+// Note: ratio() was previously blending incorrectly; it should blend the foreground color
+// with the background color by applying the alpha to the foreground part.
+// Correct blending formula: Result = FG * alpha + BG * (1 - alpha)
+// (Previously was: FG * (1 - alpha) + BG * alpha -- which is the opposite)
 function ratio(fgStr, bgStr) {
   const fg = parseColor(fgStr), bg = parseColor(bgStr);
   if (!fg || !bg) return null;
   const a = fg[3];
-  const eff = [0, 1, 2].map(i => fg[i] * (1 - a) + bg[i] * a);
+  const eff = [0, 1, 2].map(i => fg[i] * a + bg[i] * (1 - a));
   const L1 = luminance(eff), L2 = luminance(bg.slice(0, 3));
   return (Math.max(L1, L2) + 0.05) / (Math.min(L1, L2) + 0.05);
 }
