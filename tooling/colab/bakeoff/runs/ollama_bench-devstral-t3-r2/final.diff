+++ b/tooling/lib/args.js
@@ -0,0 +1,38 @@
+'use strict';
+
+/**
+ * Common argument parsing utilities shared across tooling scripts.
+ * Provides argv, has, and val helper functions.
+ */
+
+/**
+ * Get the parsed yargs argv object with common flags.
+ * @returns {Object} The yargs argv object
+ */
+const argv = process.argv.slice(2).reduce((result, arg) => {
+  const [name, value] = arg.split('=');
+  result[name.replace(/^--?/, '')] = value || true;
+  return result;
+}, {});
+
+/**
+ * Check if a flag or argument is present in argv.
+ * @param {string} name - The argument name without dots
+ * @returns {boolean} True if the argument exists
+ */
+function has(name) {
+  return argv.hasOwnProperty(name) || argv[name];
+}
+
+/**
+ * Get the value of a flag or argument from argv.
+ * @param {string} name - The argument name with dots for nested args
+ * @returns {*} The argument value or undefined
+ */
+function val(name) {
+  return name.split('.').reduce((acc, part) => {
+    return acc && acc[part];
+  }, argv);
+}
+
+module.exports = { argv, has, val };
