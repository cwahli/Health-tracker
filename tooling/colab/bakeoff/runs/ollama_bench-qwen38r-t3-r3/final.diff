diff --git a/tooling/lib/args.js b/tooling/lib/args.js
new file mode 100644
index 00000000..bcb296d3
--- /dev/null
+++ b/tooling/lib/args.js
@@ -0,0 +1,13 @@
+// args.js — the small CLI flag helpers the tooling scripts share.
+//
+// argv is process.argv with the interpreter and script name stripped.
+// has(f) asks whether a flag was given.
+// val(flag, default) returns the token after the flag, or `default` when the
+// flag was not given at all.
+'use strict';
+
+const argv = process.argv.slice(2);
+const has = f => argv.includes(f);
+const val = (f, d) => { const i = argv.indexOf(f); return i === -1 ? d : argv[i + 1]; };
+
+module.exports = { argv, has, val };
