diff --git a/tooling/lib/args.js b/tooling/lib/args.js
new file mode 100644
index 00000000..680740a1
--- /dev/null
+++ b/tooling/lib/args.js
@@ -0,0 +1,29 @@
+const args = process.argv.slice(2);
+
+/**
+ * Check if an argument exists in argv
+ * @param {string} arg - The argument to check for (without leading dashes)
+ * @returns {boolean} True if the argument exists, false otherwise
+ */
+function has(arg) {
+  return args.includes(`--${arg}`) || args.includes(arg);
+}
+
+/**
+ * Get a flag value with optional default
+ * @param {string} arg - The flag name without leading dashes
+ * @param {*} [default_] - Default value if the flag is not present (optional)
+ * @returns {*} The argument value after `--`, or undefined if not present and no default supplied
+ */
+function val(arg, default_) {
+  const idx = args.indexOf(`--${arg}`);
+  return idx === -1 ? default_ : args[idx + 1];
+}
+
+/**
+ * Get the full argv array (for scripts that need raw positional args)
+ * @returns {string[]} The slice of process.argv from index 2 onward
+ */
+const argv = args;
+
+module.exports = { args, argv, has, val };
