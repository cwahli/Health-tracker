--- /dev/null
+++ b/tooling/lib/args.js
@@ -0,0 +1,15 @@
+'use strict';
+
+const argv = process.argv.slice(2);
+
+module.exports = {
+  argv,
+  has: (flag) => argv.includes(flag),
+  val: (flag, defaultValue) => {
+    const index = argv.indexOf(flag);
+    if (index === -1 || index + 1 >= argv.length) {
+      return defaultValue;
+    }
+    return argv[index + 1];
+  }
+};
