{
  "master": "opencode",
  "bots": [
    {
      "id": "opencode",
      "name": "OpenCode Bot",
      "enabled": true,
      "telegram": {
        "tokenEnv": "OPENCODE_BOT_TOKEN",
        "allowedUserIds": [
          6218257274
        ]
      },
      "agent": {
        "kind": "opencode",
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "high",
        "defaultAgent": "build",
        "workspace": "/home/ubuntu/src/Health-tracker",
        "timeoutMs": 900000,
        "thinking": true,
        "allowExternalDirectory": true,
        "playwrightOutputDir": "/tmp/opencode-bot-shots",
        "sharedSkills": [
          ".agents/skills",
          "/home/ubuntu/opencode-bot/scripts/skills",
          "~/.hermes/shared_skills/social-media/telegram-media-delivery",
          "~/.hermes/shared_skills/autonomous-ai-agents/opencode"
        ]
      },
      "progress": {
        "mode": "concise",
        "editIntervalMs": 2500,
        "maxEdits": 40,
        "maxChars": 220
      },
      "session": {
        "mode": "per-chat"
      }
    },
    {
      "id": "android",
      "name": "Android OpenCode Bot",
      "enabled": true,
      "telegram": {
        "tokenEnv": "ANDROID_OPENCODE_BOT_TOKEN"
      },
      "agent": {
        "workspace": "/root/Health-tracker",
        "opencodeBin": "/root/.opencode/bin/opencode",
        "playwrightOutputDir": null,
        "sharedSkills": [
          ".agents/skills",
          "/root/Health-tracker/scripts/skills",
          "~/.hermes/shared_skills/social-media/telegram-media-delivery",
          "~/.hermes/shared_skills/autonomous-ai-agents/opencode"
        ],
        "model": "opencode/muse-spark-1.3-contributor-free",
        "variant": null
      }
    },
    {
      "id": "collab",
      "name": "Collab Bot",
      "enabled": true,
      "telegram": {
        "tokenEnv": "COLLAB_BOT_TOKEN",
        "allowedUserIds": [
          6218257274
        ]
      },
      "agent": {
        "kind": "collab",
        "workspace": "/root/Health-tracker",
        "opencodeBin": "/root/.opencode/bin/opencode",
        "model": "opencode/muse-spark-1.3-contributor-free",
        "variant": null
      }
    }
  ]
}
