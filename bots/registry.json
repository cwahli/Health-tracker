    },
    {
      "id": "hermes_bug_ticket",
      "name": "Bug Ticket Bot",
      "runtime": "hermes",
      "enabled": false,
      "notes": "V-30.2 packer. Start enabled:false until one E2E reply via HERMES_BUG_TICKET_TOKEN. Never links orchestrator-dispatcher.",
      "telegram": {
        "tokenEnv": "HERMES_BUG_TICKET_TOKEN",
        "allowedUserIds": [
          6218257274
        ]
      },
      "hermes": {
        "profile": "bug_ticket",
        "username": null
      },
      "agent": {
        "kind": "hermes"
      }
    }
  ]
