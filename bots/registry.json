{
  "master": "vm",
  "bots": [
    {
      "id": "tg_provider_router",
      "name": "TG Provider Router",
      "runtime": "tg-provider-router",
      "enabled": true,
      "path": "tools/telegram-provider-router",
      "notes": "Unified Telegram long-poller → OpenCode/Cline/TokenHarbor/Cloudflare/Freebuff. See tools/telegram-provider-router/README.md. Live box: ~/.config/telegram-opencode/router/",
      "telegram": {
        "tokenEnv": "TELEGRAM_BOT_TOKEN",
        "onePollerOnly": true
      }
    },
    {
      "id": "vm",
      "name": "VM Bot",
      "runtime": "bot-host",
      "enabled": true,
      "telegram": {
        "tokenEnv": "VM_BOT_TOKEN",
        "allowedUserIds": [
          6218257274
        ]
      },
      "agent": {
        "kind": "opencode",
        "model": "opencode/nemotron-3.5-lightning-free",
        "variant": null,
        "smallModel": "opencode/space-bunny-free",
        "defaultAgent": "build",
        "workspace": "/home/ubuntu/src/Health-tracker",
        "timeoutMs": 900000,
        "thinking": true,
        "allowExternalDirectory": true,
        "playwrightOutputDir": "/tmp/bot-host-shots-vm",
        "sharedSkills": [
          ".agents/skills",
          "/home/ubuntu/bot-host/scripts/skills/common"
        ]
      },
      "progress": {
        "mode": "concise",
        "editIntervalMs": 2500,
        "maxEdits": 40,
        "maxChars": 220
      },
      "session": {
        "mode": "per-chat"
      }
    },
    {
      "id": "mobile",
      "name": "Mobile Bot 8768",
