    {
      "id": "hermes_qa_onboarding",
      "name": "Onboarding QA Bot",
      "runtime": "hermes",
      "enabled": false,
      "telegram": {
        "tokenEnv": "HERMES_QA_ONBOARDING_TOKEN"
      },
      "hermes": {
