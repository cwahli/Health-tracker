{
  "master": "vm",
  "bots": [
    {
      "id": "vm",
      "name": "VM Bot",
      "runtime": "bot-host",
      "enabled": true,
      "telegram": {
        "tokenEnv": "VM_BOT_TOKEN",
        "allowedUserIds": [6218257274]
      },
      "agent": {
        "kind": "opencode",
        "model": "opencode/big-pickle",
        "variant": "low",
        "defaultAgent": "build",
        "workspace": "/home/ubuntu/src/Health-tracker",
        "timeoutMs": 900000,
        "thinking": true,
        "allowExternalDirectory": true,
        "playwrightOutputDir": "/tmp/bot-host-shots-vm",
        "sharedSkills": [
          ".agents/skills",
          "/home/ubuntu/bot-host/scripts/skills/common"
        ]
      },
      "progress": {
        "mode": "concise",
        "editIntervalMs": 2500,
        "maxEdits": 40,
        "maxChars": 220
      },
      "session": {
        "mode": "per-chat"
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode Bot",
      "runtime": "bot-host",
      "enabled": true,
      "telegram": {
        "tokenEnv": "OPENCODE_BOT_TOKEN"
      },
      "agent": {
        "playwrightOutputDir": "/tmp/bot-host-shots"
      }
    },
    {
      "id": "android",
      "name": "Mobile Bot",
      "runtime": "device",
      "enabled": false,
      "telegram": {
        "tokenEnv": "ANDROID_OPENCODE_BOT_TOKEN"
      },
      "agent": {
        "kind": "opencode",
        "workspace": "/root/Health-tracker",
        "opencodeBin": "/root/.opencode/bin/opencode",
        "playwrightOutputDir": null,
        "sharedSkills": [
          ".agents/skills",
          "/root/Health-tracker/scripts/skills",
          "~/.hermes/shared_skills/social-media/telegram-media-delivery",
          "~/.hermes/shared_skills/autonomous-ai-agents/opencode"
        ],
        "model": "opencode/muse-spark-1.3-contributor-free",
        "variant": null
      }
    },
    {
      "id": "vm2",
