{
  "master": "vm",
  "bots": [
    {
      "id": "tg_provider_router",
      "name": "TG Provider Router",
      "runtime": "tg-provider-router",
      "enabled": true,
      "path": "tools/telegram-provider-router",
      "notes": "Unified Telegram long-poller \u2192 OpenCode/Cline/TokenHarbor/Cloudflare/Freebuff. See tools/telegram-provider-router/README.md. Live box: ~/.config/telegram-opencode/router/",
      "telegram": {
        "tokenEnv": "TELEGRAM_BOT_TOKEN",
        "onePollerOnly": true
      }
    },
    {
      "id": "vm",
      "name": "VM Bot",
      "runtime": "bot-host",
      "enabled": true,
      "telegram": {
        "tokenEnv": "VM_BOT_TOKEN",
        "allowedUserIds": [
          6218257274
        ]
      },
      "agent": {
        "kind": "opencode",
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "high",
        "smallModel": "opencode-go/deepseek-v4.1-flash",
        "defaultAgent": "build",
        "workspace": "/home/ubuntu/src/Health-tracker",
        "timeoutMs": 900000,
        "thinking": true,
        "allowExternalDirectory": true,
        "playwrightOutputDir": "/tmp/bot-host-shots-vm",
        "sharedSkills": [
          ".agents/skills",
          "/home/ubuntu/bot-host/scripts/skills/common"
        ]
      },
      "progress": {
        "mode": "concise",
        "editIntervalMs": 2500,
        "maxEdits": 40,
        "maxChars": 220
      },
      "session": {
        "mode": "per-chat"
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode Bot",
      "runtime": "bot-host",
      "enabled": true,
      "telegram": {
        "tokenEnv": "OPENCODE_BOT_TOKEN"
      },
      "agent": {
        "playwrightOutputDir": "/tmp/bot-host-shots"
      }
    },
    {
      "id": "android",
      "name": "Mobile Bot",
      "runtime": "device",
      "enabled": false,
      "telegram": {
        "tokenEnv": "ANDROID_OPENCODE_BOT_TOKEN"
      },
      "agent": {
        "kind": "opencode",
        "workspace": "/root/Health-tracker",
        "opencodeBin": "/root/.opencode/bin/opencode",
        "playwrightOutputDir": null,
        "sharedSkills": [
          ".agents/skills",
          "/root/Health-tracker/scripts/skills/common"
        ],
        "model": "opencode/muse-spark-1.3-contributor-free",
        "variant": null
      }
    },
    {
      "id": "mobile",
      "name": "Mobile Bot 8768",
      "runtime": "device",
      "enabled": true,
      "telegram": {
        "tokenEnv": "MOBILE_BOT_TOKEN",
        "allowedUserIds": [
          6218257274
        ]
      },
      "agent": {
        "kind": "opencode",
        "workspace": "/root/Health-tracker",
        "opencodeBin": "/root/.opencode/bin/opencode",
        "playwrightOutputDir": null,
        "sharedSkills": [
          ".agents/skills",
          "/root/Health-tracker/scripts/skills/common"
        ],
        "model": "opencode/muse-spark-1.3-contributor-free",
        "variant": null
      }
    },
    {
      "id": "vm2",
      "name": "VM2 Bot",
      "runtime": "bot-host",
      "enabled": true,
      "telegram": {
        "tokenEnv": "VM2_BOT_TOKEN"
      },
      "agent": {
        "playwrightOutputDir": "/tmp/bot-host-shots-vm2"
      }
    },
    {
      "id": "collab",
      "name": "Collab Bot",
      "runtime": "collab",
      "enabled": true,
      "telegram": {
        "tokenEnv": "COLLAB_BOT_TOKEN",
        "allowedUserIds": [
          6218257274
        ]
      },
      "agent": {
        "kind": "collab",
        "workspace": "/root/Health-tracker",
        "opencodeBin": "/root/.opencode/bin/opencode",
        "model": "opencode/muse-spark-1.3-contributor-free",
        "variant": null
      }
    },
    {
      "id": "hermes_default",
      "name": "Health Tracker Bot",
      "runtime": "hermes",
      "enabled": false,
      "telegram": {
        "tokenEnv": "HERMES_DEFAULT_TOKEN"
      },
      "hermes": {
        "profile": "default",
        "username": "@Health_tracker_159bot"
      },
      "agent": {
        "kind": "hermes"
      }
    },
    {
      "id": "hermes_qa_meal",
